{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "uid": { "type": "string" },
      "config": {
        "type": "object",
        "properties": {
          "sensors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "tolerance": { "type": "number" }
              },
              "required": ["name", "tolerance"]
            }
          },
          "resolution": { "type": "number" }
        },
        "required": ["sensors", "resolution"]
      },
      "experiment": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "time": { "type": "number", "minimum": 0 },
            "temp_right": { "type": "number"},
            "temp_main": { "type": "number" },
            "temp_left": { "type": "number" },
            "pressure_downstream": { "type": "number" },
            "pressure_upstream": { "type": "number" }
          },
          "required": ["time", "temp_main", "temp_left", "temp_right", "pressure_downstream", "pressure_upstream"]
        }
      }
    },
    "required": ["uid", "config", "experiment"]
  }
