# Generated by compose-gen from comodo.yaml
# Do not edit directly -- edit comodo.yaml and regenerate.

x-templates:
  mqtt-env: &mqtt-env
    MQTT_HOST: ${MQTT_HOST}
    MQTT_USER: ${MQTT_USER}
    MQTT_PASS: ${MQTT_PASS}
  instrument-env: &instrument-env
    <<: *mqtt-env
  python-instrument-template: &python-instrument-template
    build:
      context: .
      dockerfile: firmware/Dockerfile
    depends_on:
      mqtt-probe-firmware:
        condition: service_healthy

name: comodo-firmware

services:
  mqtt-probe-firmware:
    build:
      context: ./
      dockerfile: mqtt_probe/Dockerfile
    environment:
      <<: *mqtt-env
      MQTT_PROBE_ID: firmware

{% for name, instr in instruments.items() %}
  {{ name }}:
    <<: *python-instrument-template
    environment:
      <<: *instrument-env
      INSTRUMENT_NAME: "{{ name }}"
      FIRMWARE: {{ instr.firmware }}
      DEVICE_ADDRESS: "{{ instr.address }}"
      ACTIVE_VARIABLES: '{{ instr.variables.keys() | list | tojson }}'
      HEARTBEAT_INTERVAL: {{ (global.heartbeat.interval | default(1) | float * 1000) | int }}{% for v_name, v_cfg in instr.variables.items() %}{% if v_cfg.sensor and v_cfg.sensor.interval %}
      INTERVAL_{{ v_name | upper }}: {{ (v_cfg.sensor.interval | float * 1000) | int }}{% endif %}{% endfor %}
{%- if instr.address.startswith('/dev/') %}
    devices:
      - "{{ instr.address }}:{{ instr.address }}"
    privileged: true
{%- endif %}
{% endfor %}{% for name, instr in instruments.items() %}
{%- for v_name, v_cfg in instr.variables.items() %}
{%- if v_cfg.setpoint_controller %}

  spc-{{ name }}-{{ v_name }}:
    build:
      context: .
      dockerfile: setpoint_controller/Dockerfile
    depends_on:
      mqtt-probe-firmware:
        condition: service_healthy
    environment:
      <<: *mqtt-env
      HEARTBEAT_INTERVAL: {{ (global.heartbeat.interval | default(1) | float * 1000) | int }}
      SENSOR: "{{ v_cfg.setpoint_controller.external_sensor }}"
      ACTUATOR: "{{ name }}/{{ v_name }}"
      K_P: {{ v_cfg.setpoint_controller.K_P }}
      K_I: {{ v_cfg.setpoint_controller.K_I }}
      K_D: {{ v_cfg.setpoint_controller.K_D }}{% if v_cfg.setpoint_controller.K_AW is defined %}
      K_AW: {{ v_cfg.setpoint_controller.K_AW }}{% endif %}{% if v_cfg.setpoint_controller.K_DF is defined %}
      K_DF: {{ v_cfg.setpoint_controller.K_DF }}{% endif %}{% if v_cfg.setpoint_controller.OUT_MAX_R is defined %}
      OUT_MAX_R: {{ v_cfg.setpoint_controller.OUT_MAX_R }}{% endif %}
      OUT_MIN: {{ v_cfg.actuator.min | default(v_cfg.sensor.min | default(0)) }}
      OUT_MAX: {{ v_cfg.actuator.max | default(v_cfg.sensor.max | default(100)) }}
{%- endif %}
{%- endfor -%}
{% endfor %}

{% if 'mass_flow' in instruments %}
volumes:
  massflow_read:
{% endif %}
