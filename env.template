# Template file for comodo environment variables
#
# By default the parameters here are in a format suitable for envsubst
# i.e. `envsubst env.template > .env` means ${VAR} becmomes 'foo' if VAR='foo'.
# This is to make automated deploying easy.
#
# If you are deploying comodo yourself (i.e. if you are reading this) you should
# edit the file below replacing e.g. ${ENV_MQTT_USERNAME} with the value you
# would like. Unless otherwise indicated, you can use any value.
#
# For example:
# - MQTT_USER=${ENV_MQTT_USERNAME}
# + MQTT_USER=myusername
#
# For optional variables you may comment the specific row, or make sure the ENV_*
# variable is not set, or have nothing after the '=' sign. These lines have the same effect:
# - # FIRMWARE_HOST_USER=${ENV_FIRMWARE_HOST_USER}
# - FIRMWARE_HOST=
# - FIRMWARE_HOST_USER=${ENV_FIRMWARE_HOST_USER}  # as long as ENV_FIRMWARE_HOST_USER is not set

# ------------------------------------------------------------------------------
# Remote hosts

# IP address or FQDN of the host for each of the stacks
MQTT_HOST=${ENV_MQTT_HOST}
DATA_HOST=${ENV_DATA_HOST}
FIRMWARE_HOST=${ENV_FIRMWARE_HOST}                  # Optional - Only needed if deploying firmware stack remotely

# Users on remote hosts. The user must have ssh keys configured.
MQTT_HOST_USER=${ENV_MQTT_HOST_USER}                # Optional - Only needed if deploying mqtt stack remotely.
DATA_HOST_USER=${ENV_DATA_HOST_USER}                # Optional - Only needed if deploying data stack remotely.
FIRMWARE_HOST_USER=${ENV_FIRMWARE_HOST_USER}        # Optional - Only needed if deploying firmware stack remotely.

# ------------------------------------------------------------------------------
# Messaging system (MQTT)

MQTT_USER=${ENV_MQTT_USERNAME}
MQTT_PASS=${ENV_MQTT_PASSWORD}

# ------------------------------------------------------------------------------
# Time series database (influxdb)

INFLUX_TOKEN=${ENV_INFLUX_TOKEN}
INFLUX_BUCKET=${ENV_INFLUX_BUCKET}                  # this currently has to be "comodo" for graphana to work
INFLUX_ORG=${ENV_INFLUX_ORG}

# ------------------------------------------------------------------------------
# Dashboard (grafana)

GRAFANA_DASHBOARD_URL=${ENV_GRAFANA_DASHBOARD_URL}  # Optional - Set only to override default dashboard

# ------------------------------------------------------------------------------
# Firmware

SIMULATE_INSTRUMENTS=${ENV_SIMULATE_SENSORS}            # Optional - Defaults to false
