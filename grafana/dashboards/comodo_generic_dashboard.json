      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "Comodo"
          },
          "query": "from(bucket: \"comodo\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mqtt_consumer\")\n  |> filter(fn: (r) => r.topic == \"controller/heartbeat\" and r._field == \"state_status\")\n  |> map(fn: (r) => ({ _time: r._time, _value: r._value, topic_last: \"controller\" }))\n  |> group(columns: [\"topic_last\"], mode: \"by\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n  |> yield(name: \"controller\")\n"
        },
        {
          "query": "import \"strings\"\n\n// Heartbeats report their status inside a state object, stored by Telegraf as \"state_status\"\nfrom(bucket: \"comodo\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mqtt_consumer\")\n  |> filter(fn: (r) => r.topic =~ /^(instruments|setpoint_controllers)\\/[^\\/]+\\/heartbeat$/ and r._field == \"state_status\")\n  |> map(fn: (r) => {\n      parts = strings.split(v: r.topic, t: \"/\")\n      // SPC ids are \"<sensor>--<actuator>\", with \"/\" replaced by \"-\"\n      name = if parts[0] == \"instruments\" then parts[1] else strings.replaceAll(v: parts[1], t: \"--\", u: \" \u2192 \")\n      return { _time: r._time, _value: r._value, topic_last: name }\n    })\n  |> group(columns: [\"topic_last\"], mode: \"by\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n  |> yield(name: \"last\")\n",
          "refId": "B",
          "datasource": {
            "uid": "Comodo"
          }
        }
      ],
      "title": "Comodo Status",
      "type": "state-timeline"
    },
