          },
          "query": "import \"strings\"\n\nfrom(bucket: \"comodo\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mqtt_consumer\" and r._field == \"value\")\n  |> filter(fn: (r) => r.topic =~ /^instruments\\/[^\\/]+\\/[^\\/]+\\/setpoint$/)\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n  |> map(fn: (r) => {\n      parts = strings.split(v: r.topic, t: \"/\")\n      return {_time: r._time, _value: r._value, _field: parts[1] + \"/\" + parts[2]}\n    })\n  |> group(columns: [\"_field\"])"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "bere8a3gzy800d"
          },
          "query": "import \"strings\"\n\nfrom(bucket: \"comodo\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mqtt_consumer\" and r._field == \"value\")\n  |> filter(fn: (r) => r.topic =~ /^instruments\\/[^\\/]+\\/[^\\/]+\\/measurement$/)\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> map(fn: (r) => {\n      parts = strings.split(v: r.topic, t: \"/\")\n      return {_time: r._time, _value: r._value, _field: parts[1] + \"/\" + parts[2]}\n    })\n  |> group(columns: [\"_field\"])"
        }
