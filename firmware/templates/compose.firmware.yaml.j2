# Generated by compose-gen from comodo.yaml
# Do not edit directly -- edit comodo.yaml and regenerate.

x-templates:
  mqtt-env: &mqtt-env
    MQTT_HOST: ${MQTT_HOST}
    MQTT_USER: ${MQTT_USER}
    MQTT_PASS: ${MQTT_PASS}
  instrument-env: &instrument-env
    <<: *mqtt-env
    SIMULATE: ${SIMULATE_INSTRUMENTS:-false}
  python-instrument-template: &python-instrument-template
    build:
      context: .
      dockerfile: firmware/Dockerfile
    networks:
      comodo-firmware:
    depends_on:
      mqtt-probe-firmware:
        condition: service_healthy

name: comodo-firmware

services:
  mqtt-probe-firmware:
    image: comodolab/comodo-mqtt_probe:latest
    environment:
      <<: *mqtt-env
    networks:
      comodo-firmware:

{% for name, instr in instruments.items() %}
  {{ name }}:
    <<: *python-instrument-template
    environment:
      <<: *instrument-env
      INSTRUMENT_ID: "{{ name }}"
      FIRMWARE: {{ instr.firmware }}
      DEVICE_ADDRESS: "{{ instr.address }}"
      HEARTBEAT_INTERVAL: {{ (global.heartbeat.interval | default('1s') | replace('s', '') | float * 1000) | int }}{% for v_name, v_cfg in instr.variables.items() %}{% if v_cfg.measurement and v_cfg.measurement.interval %}
      INTERVAL_{{ v_name | upper }}: {{ (v_cfg.measurement.interval | replace('s', '') | float * 1000) | int }}{% endif %}{% endfor %}
{%- if instr.address.startswith('/dev/') %}
    devices:
      - "{{ instr.address }}:{{ instr.address }}"
    privileged: true
{%- endif %}
{% endfor %}

networks:
  comodo-firmware:
    name: comodo-firmware

{% if 'mass_flow' in instruments %}
volumes:
  massflow_read:
{% endif %}
