      "pluginVersion": "12.3.0",
      "targets": [
        {
          "query": "import \"strings\"\n\nfrom(bucket: \"comodo\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mqtt_consumer\")\n  |> filter(fn: (r) => r.topic =~ /^instruments\\/[^\\/]+\\/heartbeat$/)\n  |> filter(fn: (r) => r._field == \"state\")\n  |> map(fn: (r) => {\n      parts = strings.split(v: r.topic, t: \"/\")\n      return { r with topic_last: parts[1] }\n    })\n  |> keep(columns: [\"_time\",\"_value\",\"topic_last\"])\n  |> group(columns: [\"topic_last\"], mode: \"by\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n  |> yield(name: \"last\")\n",
          "refId": "A"
        }
      ],
      "title": "Comodo Status",
      "type": "state-timeline"
    },
