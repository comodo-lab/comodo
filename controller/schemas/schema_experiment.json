{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "uid": { "type": "string" },
      "config": {
        "type": "object",
        "properties": {
          "instruments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "tolerance": { "type": "number" }
              },
              "required": ["name", "tolerance"]
            }
          },
          "resolution": { "type": "number" }
        },
        "required": ["instruments", "resolution"]
      },
      "experiment": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "time": { "type": "number", "minimum": 0 }
          },
          "required": ["time"],
          "additionalProperties": true
        }
      }
    },
    "required": ["uid", "config", "experiment"]
  }
