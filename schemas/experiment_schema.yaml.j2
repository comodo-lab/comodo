channels:
  experimentRow:
    address: experiment/row
    messages:
      experimentRow:
        payload:
          type: object
          additionalProperties: false
          required:
            - time
{% for instr_name, instr_cfg in instruments.items() -%}
{% for var_name, var_cfg in instr_cfg.variables.items() -%}
{% if "actuator" in var_cfg %}
            - {{ instr_name }}/{{ var_name }}
{% endif -%}
{% endfor -%}
{% endfor %}
          properties:
            time:
              type: number
              minimum: 0
{% for instr_name, instr_cfg in instruments.items() -%}
{% for var_name, var_cfg in instr_cfg.variables.items() -%}
{% if "actuator" in var_cfg %}
            {{ instr_name }}/{{ var_name }}:
              type: number
              minimum: {{ var_cfg.actuator.min }}
              maximum: {{ var_cfg.actuator.max }}
            {{ instr_name }}/{{ var_name }}_profile:
              type: string
              enum: ["linear", "exponential", "logarithmic", "step"]
{% endif -%}
{% endfor -%}
{% endfor %}
