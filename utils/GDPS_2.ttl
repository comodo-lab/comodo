@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix schema: <http://schema.org/> .
@prefix schema1: <https://nucleus.org/schema#> .
@prefix ex: <http://example.org/> .

ex:GDPS a schema:Experiment ;
	schema:description "Gas permeation system" ;
	schema:hasData ex:Experiment_Metadata, ex:Material_Data, ex:Parameters ;
	schema:hasTestCollection ex:Test_Collection ;
	schema:name "GDPS_2" ;
	schema:uuid "5478" .

ex:Experiment_Metadata a schema:MetaData ;
	schema:user "Adam" ;
	schema:experiment_name "Experiment XYZ" ;
	schema:start_time "2025-05-12T08:00:00Z" ;
	schema:stop_time "2025-05-12T10:00:00Z" ;
	schema:influx_location "nucleus/a" .

ex:Material_Data a schema:Data ;
	schema:composition "Steel" ;
	schema:size "Medium" .

ex:Test_Collection a schema:Quality_tests, schema:Requirements ;
	schema:hasIndividualTestsList ex:test_001, ex:test_002 ;
	schema:name "Quality Tests", "Requirements" ;
	schema:hasRequirement ex:StartRequirements, ex:GlobalRequirements, ex:ShutdownRequirements .

ex:GlobalRequirements a schema:Requirements ;
	schema:hasIndividualTests ex:MaxFurnaceTemperature ;
	schema:name "Global_Requirements" ;
	schema:description "Requirements that are checked every set" .

ex:MaxFurnaceTemperature a schema:Requirement ;
	schema:value "600" ;
	schema:operator ex:OperatorLT ;
	schema:unit "Celsius" ;
	schema:name "MaxFurnaceTemperature" .

ex:MinFurnaceTemperature a schema:Requirement ;
	schema:value "0" ;
	schema:operator ex:OperatorGT ;
	schema:unit "Celsius" ;
	schema:name "MinFurnaceTemperature" .

ex:test_001 a schema:Test ;
	schema:name "test_001" ;
	schema:description "Tests set temperature of surrounding heating devices" .

ex:test_002 a schema:Test ;
	schema:name "pressure_stability_test" ;
	schema:description "Ensures pressure is within ±10%" .

ex:Parameters a schema:Time_Series_Data ;
	schema:hasSensor ex:Furnace_Center_Sensor, ex:Furnace_Left_Sensor, ex:Furnace_Right_Sensor, ex:pressure_inlet, ex:pressure_outlet ;
	schema:name "Sensors" .

ex:Furnace_Center_Sensor a schema:Sensor ;
	schema:hasSet_value ex:set_temperature_center ;
	schema:hasRead_value ex:read_temperature_center ;
	schema:hasTest ex:quality_test_001 ;
    schema:pass "false" ;
	schema:name "Furnace_Center_Sensor" .

ex:Furnace_Left_Sensor a schema:Sensor ;
	schema:hasSet_value ex:set_temperature_left ;
	schema:hasRead_value ex:read_temperature_left ;
	schema:hasTest ex:quality_test_001 ;
    schema:pass "false" ;
	schema:name "Furnace_Left_Sensor" .

ex:Furnace_Right_Sensor a schema:Sensor ;
	schema:hasSet_value ex:set_temperature_right ;
	schema:hasRead_value ex:read_temperature_right ;
	schema:hasTest ex:quality_test_001 ;
    schema:pass "false" ;
	schema:name "Furnace_Right_Sensor" .

ex:pressure_inlet a schema:Sensor ;
	schema:hasSet_value ex:set_pressure_inlet ;
	schema:hasRead_value ex:read_pressure_inlet ;
	schema:hasTest ex:quality_test_002 ;
	schema:name "Pressure_Inlet" .

ex:pressure_outlet a schema:Sensor ;
	schema:hasSet_value ex:set_pressure_outlet ;
	schema:hasRead_value ex:read_pressure_outlet ;
	schema:hasTest ex:quality_test_002 ;
	schema:name "Pressure_Outlet" .

ex:set_temperature_left a schema:Data ;
	schema:hasRequirement ex:MaxFurnaceTemperature, ex:MinFurnaceTemperature ;
	schema:name "set_temperature_left" ;
	schema:unit "Celsius" ;
	schema:data_type "float" .

ex:read_temperature_left a schema:Data ;
	schema:name "read_temperature_left" ;
	schema:unit "Celsius" ;
	schema:data_type "float" .

ex:set_temperature_center a schema:Data ;
	schema:hasRequirement ex:MaxFurnaceTemperature, ex:MinFurnaceTemperature ;
	schema:hasTest ex:test_001 ;
	schema:name "set_temperature_center" ;
	schema:unit "Celsius" ;
	schema:conversion "10" ;
	schema:data_type "float" .

ex:read_temperature_center a schema:Data ;
	schema:name "read_temperature_center" ;
	schema:unit "Celsius" ;
	schema:data_type "float" .

ex:set_temperature_right a schema:Data ;
	schema:hasRequirement ex:MaxFurnaceTemperature, ex:MinFurnaceTemperature ;
	schema:name "set_temperature_right" ;
	schema:unit "Celsius" ;
	schema:data_type "float" .

ex:read_temperature_right a schema:Data ;
	schema:name "read_temperature_right" ;
	schema:unit "Celsius" ;
	schema:data_type "float" .

ex:set_pressure_inlet a schema:Data ;
	schema:name "set_pressure_inlet" ;
	schema:data_type "float" .

ex:read_pressure_inlet a schema:Data ;
	schema:name "read_pressure_inlet" ;
	schema:data_type "float" .

ex:set_pressure_outlet a schema:Data ;
	schema:name "set_pressure_outlet" ;
	schema:data_type "float" .

ex:read_pressure_outlet a schema:Data ;
	schema:name "read_pressure_outlet" ;
	schema:data_type "float" .

ex:quality_test_001 a schema:Test ;
	schema:name "temperature_stability_check" ;
	schema:description "Ensures temperature is within ±1°C" .

ex:quality_test_002 a schema:Test ;
	schema:name "pressure_stability_test" ;
	schema:description "Ensures pressure is within ±10%" .

ex:OperatorGT a schema:Operator ;
	schema:name "Greater than" ;
	schema:operator ">" .

ex:OperatorLT a schema:Operator ;
	schema:name "Less than" ;
	schema:operator "<" .

ex:OperatorET a schema:Operator ;
	schema:name "Equal to" ;
	schema:operator "==" .

