@prefix ex: <https://example.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/LibrtiSystem/0001> a ex:LibrtiSystem ;
    ex:emulators [ ex:tritium_inventory <file:///work/tritium_inventory> ] ;
    ex:global_set [ ex:version "1.0" ] ;
    ex:instruments [ ex:accelerator <file:///work/accelerator> ;
            ex:blanket_module <file:///work/blanket_module> ;
            ex:deuterion_source <file:///work/deuterion_source> ;
            ex:target_chamber <file:///work/target_chamber> ;
            ex:tritium_extraction_system <file:///work/tritium_extraction_system> ;
            ex:tritium_storage <file:///work/tritium_storage> ] ;
    ex:visualisations [ ex:accelerator_graph <file:///work/accelerator_graph> ;
            ex:blanket_module_graph <file:///work/blanket_module_graph> ;
            ex:deuterion_source_graph <file:///work/deuterion_source_graph> ;
            ex:tritium_extraction_system_gauge <file:///work/tritium_extraction_system_gauge> ] .

<file:///work/DC_voltage> ex:address "192.168.111.XXX" ;
    ex:measurement_interval "1s" ;
    ex:sensor [ ex:max "2000.0"^^xsd:float ;
            ex:min "0.0"^^xsd:float ;
            ex:type "float" ;
            ex:unit "V" ] .

<file:///work/accelerator> ex:sensors [ ex:DC_voltage <file:///work/DC_voltage> ;
            ex:coolant_temperature <file:///work/coolant_temperature> ;
            ex:turbo_pump_stage_1 <file:///work/turbo_pump_stage_1> ;
            ex:turbo_pump_stage_2 <file:///work/turbo_pump_stage_2> ;
            ex:turbo_pump_stage_3 <file:///work/turbo_pump_stage_3> ] .

<file:///work/accelerator_graph> ex:title "Deuterion accelerator" ;
    ex:vis_type "Graph" ;
    ex:y_values "DC_voltage",
        "coolant_temperature",
        "turbo_pump_stage_1",
        "turbo_pump_stage_2",
        "turbo_pump_stage_3" .

<file:///work/blanket_module> ex:sensors [ ex:breeder_temperature <file:///work/breeder_temperature> ;
            ex:coolant_temperature <file:///work/coolant_temperature> ;
            ex:neutron_breeder_flux <file:///work/neutron_breeder_flux> ;
            ex:neutron_structure_flux <file:///work/neutron_structure_flux> ;
            ex:structural_temperature <file:///work/structural_temperature> ] .

<file:///work/blanket_module_graph> ex:title "Blanket module" ;
    ex:vis_type "Graph" ;
    ex:y_values "breeder_temperature",
        "neutron_breeder_flux",
        "neutron_structure_flux",
        "structural_temperature" .

<file:///work/breeder_temperature> ex:address "192.168.111.XXX" ;
    ex:measurement_interval "1s" ;
    ex:sensor [ ex:max "1000.0"^^xsd:float ;
            ex:min "0.0"^^xsd:float ;
            ex:type "float" ;
            ex:unit "k" ] .

<file:///work/deterium_flow_controller> ex:actuator [ ex:max "100.0"^^xsd:float ;
            ex:min "0.0"^^xsd:float ;
            ex:type "float" ;
            ex:unit "\\%" ] ;
    ex:address "192.168.111.XXX" ;
    ex:measurement_interval "1s" ;
    ex:sensor [ ex:max "20.0"^^xsd:float ;
            ex:min "0.0"^^xsd:float ;
            ex:type "float" ;
            ex:unit "g/min" ] .

<file:///work/deuterion_source> ex:sensors [ ex:deterium_flow_controller <file:///work/deterium_flow_controller> ;
            ex:ionisation_source_power <file:///work/ionisation_source_power> ] .

<file:///work/deuterion_source_graph> ex:title "Deuterion Source" ;
    ex:vis_type "Graph" ;
    ex:y_values "deterium_flow_controller",
        "ionisation_source_power" .

<file:///work/diffusion> ex:material_models [ ex:steel <file:///work/steel> ] .

<file:///work/extraction_pressure> ex:address "192.168.111.XXX" ;
    ex:measurement_interval "1s" ;
    ex:sensor [ ex:max "30.0"^^xsd:float ;
            ex:min "0.0"^^xsd:float ;
            ex:type "float" ;
            ex:unit "bar" ] .

<file:///work/extraction_temperature> ex:address "192.168.111.XXX" ;
    ex:measurement_interval "1s" ;
    ex:sensor [ ex:max "1000.0"^^xsd:float ;
            ex:min "0.0"^^xsd:float ;
            ex:type "float" ;
            ex:unit "k" ] .

<file:///work/gas_pressure> ex:address "192.168.111.XXX" ;
    ex:measurement_interval "1s" ;
    ex:sensor [ ex:max "10.0"^^xsd:float ;
            ex:min "0.0"^^xsd:float ;
            ex:type "float" ;
            ex:unit "bar" ] .

<file:///work/gas_temperature> ex:address "192.168.111.XXX" ;
    ex:measurement_interval "1s" ;
    ex:sensor [ ex:max "400.0"^^xsd:float ;
            ex:min "0.0"^^xsd:float ;
            ex:type "float" ;
            ex:unit "k" ] .

<file:///work/getter_beds_temperature> ex:address "192.168.1.100" ;
    ex:sensor [ ex:max "400.0"^^xsd:float ;
            ex:min "0.0"^^xsd:float ;
            ex:type "float" ;
            ex:unit "k" ] .

<file:///work/ionisation_source_power> ex:address "192.168.111.XXX" ;
    ex:measurement_interval "1s" ;
    ex:sensor [ ex:max "200.0"^^xsd:float ;
            ex:min "0.0"^^xsd:float ;
            ex:type "float" ;
            ex:unit "W" ] .

<file:///work/neutron_breeder_flux> ex:address "192.168.111.XXX" ;
    ex:measurement_interval "1s" ;
    ex:sensor [ ex:max "1000000000.0"^^xsd:float ;
            ex:min "0.0"^^xsd:float ;
            ex:type "float" ;
            ex:unit "n/cm^2s" ] .

<file:///work/neutron_structure_flux> ex:address "192.168.111.XXX" ;
    ex:measurement_interval "1s" ;
    ex:sensor [ ex:max "1000000000.0"^^xsd:float ;
            ex:min "0.0"^^xsd:float ;
            ex:type "float" ;
            ex:unit "n/cm^2s" ] .

<file:///work/structural_temperature> ex:address "192.168.111.XXX" ;
    ex:measurement_interval "1s" ;
    ex:sensor [ ex:max "1000.0"^^xsd:float ;
            ex:min "0.0"^^xsd:float ;
            ex:type "float" ;
            ex:unit "k" ] .

<file:///work/target_chamber> ex:sensors [ ex:gas_pressure <file:///work/gas_pressure> ;
            ex:gas_temperature <file:///work/gas_temperature> ] .

<file:///work/tritium_concentration> ex:address "192.168.111.XXX" ;
    ex:measurement_interval "1s" ;
    ex:sensor [ ex:max "1.0"^^xsd:float ;
            ex:min "0.0"^^xsd:float ;
            ex:type "float" ;
            ex:unit "g/cm^3" ] .

<file:///work/tritium_extraction_system> ex:sensors [ ex:extraction_pressure <file:///work/extraction_pressure> ;
            ex:extraction_temperature <file:///work/extraction_temperature> ;
            ex:tritium_concentration <file:///work/tritium_concentration> ] .

<file:///work/tritium_extraction_system_gauge> ex:title "Tritium Extraction System" ;
    ex:value "tritium_concentration",
        "tritium_storage" ;
    ex:vis_type "Gauge" .

<file:///work/tritium_inventory> ex:components [ ex:diffusion <file:///work/diffusion> ] ;
    ex:outputs [ ex:quantity "librti:TritiumInventory" ;
            ex:unit "grams" ] .

<file:///work/tritium_storage> ex:sensors [ ex:getter_beds_temperature <file:///work/getter_beds_temperature> ] .

<file:///work/turbo_pump_stage_1> ex:address "192.168.111.XXX" ;
    ex:measurement_interval "1s" ;
    ex:sensor [ ex:max "200.0"^^xsd:float ;
            ex:min "0.0"^^xsd:float ;
            ex:type "float" ;
            ex:unit "W" ] .

<file:///work/turbo_pump_stage_2> ex:address "192.168.111.XXX" ;
    ex:measurement_interval "1s" ;
    ex:sensor [ ex:max "200.0"^^xsd:float ;
            ex:min "0.0"^^xsd:float ;
            ex:type "float" ;
            ex:unit "W" ] .

<file:///work/turbo_pump_stage_3> ex:address "192.168.111.XXX" ;
    ex:measurement_interval "1s" ;
    ex:sensor [ ex:max "200.0"^^xsd:float ;
            ex:min "0.0"^^xsd:float ;
            ex:type "float" ;
            ex:unit "W" ] .

<https://example.org/workflow/Galaxy_WF_3> a ex:Workflow ;
    ex:name "Real-time Temperature Monitoring" ;
    ex:status <https://example.org/workflow/Galaxy_WF_3/status> ;
    ex:type "Online" ;
    ex:url <https://usegalaxy.org/workflow/11111> .

<https://example.org/workflow/Galaxy_WF_3/status> ex:status "" .

<file:///work/coolant_temperature> ex:address "192.168.111.XXX" ;
    ex:measurement_interval "1s" ;
    ex:sensor [ ex:max "1000.0"^^xsd:float ;
            ex:min "0.0"^^xsd:float ;
            ex:type "float" ;
            ex:unit "k" ],
        [ ex:max "200.0"^^xsd:float ;
            ex:min "0.0"^^xsd:float ;
            ex:type "float" ;
            ex:unit "K" ] .

<file:///work/steel> ex:model_ref "librti:diffusion/steel" ;
    ex:parameters "diffusion_coefficient" ;
    ex:update_policy "bayesian" ;
    ex:updated_from [ ex:condition <file:///work/steel> ;
            ex:source "gdps" ] .

