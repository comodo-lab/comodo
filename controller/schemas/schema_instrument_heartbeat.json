{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "name": {
            "type": "string"
        },
        "status": {
            "type": "string",
            "enum": ["awaiting_config", "no_setpoint", "adjusting", "ready", "error"]
        },
        "setpoint": {
            "type": ["number", "null"]
        },
        "config": {
            "type": "object",
            "properties": {
                "tolerance": {
                    "type": ["number", "null"]
                }
            },
            "required": ["tolerance"]
        }
    },
    "required": ["name", "status", "setpoint", "config"]
}
