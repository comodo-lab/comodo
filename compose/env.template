# Template file for comodo environment variables
#
# Save a copy of this file as '.env' in the 'compose' directory:
#   cp compose/env.template compose/.env
# and fill in the values by replacing ${***} with the value you would like.
# For example:
# - MQTT_USER=${ENV_MQTT_USERNAME}
# + MQTT_USER=myusername
#
# See "Environment variables" in the main README for details on each of them.
#
# If all the stacks run on this machine, only the MQTT and InfluxDB credentials are needed.
#
# For optional variables you may prepend the row with #, have nothing after the '=' sign,
# delete the row, or make sure the ENV_* variable is not set.
# These lines have the same effect:
# - # FIRMWARE_HOST_USER=${ENV_FIRMWARE_HOST_USER}
# - FIRMWARE_HOST=
# -
# - FIRMWARE_HOST_USER=${ENV_FIRMWARE_HOST_USER}  # <- only if ENV_FIRMWARE_HOST_USER is unset

# ------------------------------------------------------------------------------
# Remote hosts

# IP address or FQDN of the host for each of the stacks.
# Leave empty for stacks running on this machine: they are then reached by their service names, on the shared docker network.
MQTT_HOST=${ENV_MQTT_HOST}                          # Optional - Only needed if deploying mqtt stack remotely
DATA_HOST=${ENV_DATA_HOST}                          # Optional - Only needed if deploying data stack remotely
FIRMWARE_HOST=${ENV_FIRMWARE_HOST}                  # Optional - Only needed if deploying firmware stack remotely

# Users on remote hosts. The user must have ssh keys configured.
MQTT_HOST_USER=${ENV_MQTT_HOST_USER}                # Optional - Only needed if deploying mqtt stack remotely.
DATA_HOST_USER=${ENV_DATA_HOST_USER}                # Optional - Only needed if deploying data stack remotely.
FIRMWARE_HOST_USER=${ENV_FIRMWARE_HOST_USER}        # Optional - Only needed if deploying firmware stack remotely.

# ------------------------------------------------------------------------------
# Messaging system (MQTT)

MQTT_USER=${ENV_MQTT_USERNAME}
MQTT_PASS=${ENV_MQTT_PASSWORD}

# ------------------------------------------------------------------------------
# Time series database (influxdb)

INFLUX_TOKEN=${ENV_INFLUX_TOKEN}
INFLUX_BUCKET=${ENV_INFLUX_BUCKET}                  # this currently has to be "comodo" for grafana to work
INFLUX_ORG=${ENV_INFLUX_ORG}

# ------------------------------------------------------------------------------
# Dashboard (grafana)

GRAFANA_DASHBOARD_URL=${ENV_GRAFANA_DASHBOARD_URL}  # Optional - Set only to override default dashboard

# ------------------------------------------------------------------------------
# Comodo images

COMODO_TAG=${ENV_COMODO_TAG}                        # Optional - Tag of the published images to deploy ('latest' if not set)
DEVELOPER=${ENV_DEVELOPER}                          # Optional - Set to true to always build the images from the local code
