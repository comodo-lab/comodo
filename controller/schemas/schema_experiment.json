{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "id": { "type": "string" },
      "config": {
        "type": "object",
        "properties": {
          "instruments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "tolerance": { "type": "number" }
              },
              "required": ["name", "tolerance"]
            }
          },
          "resolution": { "type": "number" }
        },
        "required": ["instruments", "resolution"]
      },
      "experiment_definition": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "time": { "type": "number", "minimum": 0 },
            "furnace": { "type": "number" },
            "pressure_downstream": { "type": "number" }
          },
          "required": ["time", "furnace", "pressure_downstream"]
        }
      }
    },
    "required": ["id", "config", "experiment_definition"]
  }
