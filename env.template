# Template file for comodo
#
# By default the parameters here are in a format suitable for envsubst
# i.e. `envsubst env.template > .env` means ${VAR} becmomes 'foo' if VAR='foo'.
# This is to make automated deploying easy. 
#
# If you are deploying comodo yourself (i.e. if you are reading this) you should
# edit the file below replacing e.g. ${ENV_MQTT_USERNAME} with the value you
# would like. Unless otherwise indicated, you can use any value.
#
# For example:
# - MQTT_USER=${ENV_MQTT_USERNAME}
# + MQTT_USER=myusername

# ------------------------------------------------------------------------------
# Messaging system (MQTT)

MQTT_HOST=${ENV_MQTT_HOST}          # use IP or FQDN of the broker's host
MQTT_USER=${ENV_MQTT_USERNAME}
MQTT_PASS=${ENV_MQTT_PASSWORD}

# ------------------------------------------------------------------------------
# Time series database (influxdb)

INFLUX_HOST=${ENV_INFLUX_ADDR}      # use IP or FQDN of the comodo-data host
INFLUX_TOKEN=${ENV_INFLUX_TOKEN}
INFLUX_BUCKET=${ENV_INFLUX_BUCKET}  # this currently has to be "comodo" for graphana to work
INFLUX_ORG=${ENV_INFLUX_ORG}        # use "comodo" if deploying locally

# ------------------------------------------------------------------------------
# Grafana

GRAFANA_HOST                        # use IP or FQDN of the comodo-data host
# GRAFANA_DASHBOARD_URL=${ENV_FRONTEND_GRAFANA_URL}    # optional url to override default
