id: https://example.org/experiment-schema
name: ExperimentSchema
prefixes:
  linkml: https://w3id.org/linkml/
  ex: https://example.org/
imports:
  - linkml:types
default_prefix: ex

classes:
  Experiment:
    tree_root: true
    slots:
      - global
      - instruments
      - visualisations

  GlobalSettings:
    slots:
      - error_timeout

  Instrument:
    slots:
      - id
      - variables

  Variable:
    slots:
      - id
      - address
      - measurement_interval
      - sensor
      - actuator
      - setpoint_controller

  SensorConfig:
    slots:
      - type
      - min
      - max
      - unit

  ActuatorConfig:
    slots:
      - type
      - min
      - max
      - unit

  SetpointControllerConfig:
    slots:
      - external_sensor
      - P
      - I
      - D
      - output_function

  Visualisation:
    abstract: true
    slots:
      - id
      - title
      - type

  Graph:
    is_a: Visualisation
    slots:
      - y_values

  Gauge:
    is_a: Visualisation
    slots:
      - value

slots:
  id:
    range: string
    identifier: true

  global:
    range: GlobalSettings

  instruments:
    range: Instrument
    multivalued: true
    inlined: true
    inlined_as_list: false

  variables:
    range: Variable
    multivalued: true
    inlined: true
    inlined_as_list: false

  sensor:
    range: SensorConfig
    inlined: true

  actuator:
    range: ActuatorConfig
    inlined: true

  setpoint_controller:
    range: SetpointControllerConfig
    inlined: true

  error_timeout:
    range: string

  address:
    range: string

  measurement_interval:
    range: string

  type:
    range: string
  min:
    range: float
  max:
    range: float
  unit:
    range: string

  external_sensor:
    range: string
  P:
    range: float
  I:
    range: float
  D:
    range: float
  output_function:
    range: string


  visualisations:
    range: Visualisation
    multivalued: true
    inlined: true
    inlined_as_list: false

  title:
    range: string
  y_values:
    multivalued: true
    range: string
  value:
    multivalued: true
    range: string