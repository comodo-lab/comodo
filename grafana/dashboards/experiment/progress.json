        "showValue": "auto",
        "tooltip": {
          "hideZeros": false,
          "mode": "single",
          "sort": "none"
        }
      },
      "pluginVersion": "12.3.0",
      "targets": [
        {
          "query": "import \"strings\"\n\nfrom(bucket: \"comodo\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mqtt_consumer\")\n  |> filter(fn: (r) => r.topic =~ /^heartbeat\\/.*/)\n  |> filter(fn: (r) => r._field == \"status\")\n  |> map(fn: (r) => {\n      parts = strings.split(v: r.topic, t: \"/\")\n      lastIndex = length(arr: parts) - 1\n      return { r with topic_last: parts[lastIndex] }\n    })\n  |> keep(columns: [\"_time\",\"_value\",\"topic_last\"])\n  |> group(columns: [\"topic_last\"], mode: \"by\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n  |> yield(name: \"last\")\n",
          "refId": "A"
        }
      ],
      "title": "Comodo Status",
      "type": "state-timeline"
    },
    {
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "id": 2,
      "options": {
        "content": "## Experiment Progress\n\nExperiment step annotations will appear here once step logging is implemented.\n\nStep data will be published to MQTT and stored in InfluxDB for display alongside the state timeline.",
        "mode": "markdown"
      },
      "title": "Experiment Steps",
      "type": "text"
    }
